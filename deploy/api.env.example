# Generate a key with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SPLAT_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
SPLAT_MAX_UPLOAD_BYTES=2147483648
SPLAT_MAX_PENDING_JOBS=8
SPLAT_STAGE_TIMEOUT_SECONDS=21600
# Optional comma-separated browser origins. Leave empty for backend-to-backend use.
SPLAT_CORS_ORIGINS=

# Optional public HTTPS: set to the VM external IP or a DNS name, without a scheme or port.
# API_DOMAIN=
